import cv2
from ultralytics import YOLO

# ==============================
# LOAD MODEL (CPU)
# ==============================
model = YOLO("D:/parking_images/parking spaces.v1i.yolov8/runs/detect/train5/weights/best.pt")
model.to("cpu")

# ==============================
# CAMERA
# ==============================
cap = cv2.VideoCapture(0)

# ==============================
# FILTER SETTINGS (IMPORTANT)
# ==============================
MIN_AREA = 2000
MAX_AREA = 20000

FRAME_WIDTH = 640
FRAME_HEIGHT = 480

# Only allow detections inside parking region
ROI_Y_MIN = 150
ROI_Y_MAX = 420

while True:
    ret, frame = cap.read()
    if not ret:
        break

    frame = cv2.resize(frame, (FRAME_WIDTH, FRAME_HEIGHT))

    results = model(frame, conf=0.4, device="cpu")

    free_slots = 0

    for r in results:
        for box in r.boxes:

            cls = int(box.cls[0])
            x1, y1, x2, y2 = map(int, box.xyxy[0])

            # ==============================
            # FILTER 1: REGION (IMPORTANT)
            # ==============================
            if y1 < ROI_Y_MIN or y2 > ROI_Y_MAX:
                continue

            # ==============================
            # FILTER 2: SIZE
            # ==============================
            area = (x2 - x1) * (y2 - y1)
            if area < MIN_AREA or area > MAX_AREA:
                continue

            # ==============================
            # DRAW
            # ==============================
            if cls == 0:
                color = (0, 255, 0)
                free_slots += 1
            else:
                color = (0, 0, 255)

            cv2.rectangle(frame, (x1, y1), (x2, y2), color, 2)

    # ==============================
    # TEXT
    # ==============================
    cv2.putText(frame, f"Free Slots: {free_slots}",
                (20, 40),
                cv2.FONT_HERSHEY_SIMPLEX,
                1,
                (0, 255, 0),
                2)

    cv2.imshow("FINAL PARKING SYSTEM", frame)

    if cv2.waitKey(1) & 0xFF == 27:
        break

cap.release()
cv2.destroyAllWindows()
